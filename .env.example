# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=your_mongo_username
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password
MONGO_DB_NAME=your_db_name
MONGO_URI=mongodb://your_mongo_username:your_mongo_password@localhost:27017/your_db_name?authSource=admin

# Server Configuration (the Docker image defaults to 3020)
PORT=your_port_number
# Set only behind a reverse proxy, so req.ip (login rate limit) is the client:
# "true", a number of hops, or e.g. "loopback, 10.0.0.0/8". Default: off.
TRUST_PROXY=

# Server Environment ("production" makes INGEST_SOCKET_TOKEN mandatory)
NODE_ENV=your_environment

# JWT Configuration. Required: without JWT_SECRET login and every mutating
# route are refused. Use at least 32 random characters.
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=your_jwt_expiration_time

# Refresh Token Configuration
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRATION=your_refresh_token_expiration_time

# Phase 0 login (POST /api/v1/auth/login): single bootstrap admin.
# Hash with: pnpm exec bcrypt '<password>' 12
# (in docker-compose files write every $ of the hash as $$)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Login attempts per client IP and window (defaults: 10 per 15 minutes)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Trust the X-User-Id header set by the v2 gateway forwardAuth.
# Only enable when this service is reachable exclusively through the gateway.
TRUST_FORWARD_AUTH=false

# Cors Configuration: comma separated browser origins allowed to call the API
# (every dashboard origin, and the gateway's public origin). Others get 403.
ALLOWED_ORIGINS=http://localhost:3000

# WebSocket Configuration (upstream AIS feeds this service connects to)
WEBSOCKET_URI=ws://your_websocket_host:your_websocket_port
WEBSOCKET_BATAM_URI=ws://your_batam_websocket_host:your_websocket_port
WEBSOCKET_TOKEN=your_websocket_token

# Ingest socket.io server for ais:data pushers
WEBSOCKET_SERVER_PORT=3004
# Shared secret pushers send as io(url, { auth: { token } }) or
# "Authorization: Bearer <token>". Required when NODE_ENV=production
# (otherwise every connection is refused).
INGEST_SOCKET_TOKEN=
# ais:data messages per second and burst allowed per connection
INGEST_SOCKET_RATE_LIMIT=100
INGEST_SOCKET_RATE_BURST=200

# Comma separated MMSIs whose CII is recomputed on every AIS position.
# Empty (default) = automatic CII updates disabled, as before phase 0.
CII_ENABLED_MMSIS=
